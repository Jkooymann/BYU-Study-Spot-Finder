<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Users</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-4">
        <h1>Users</h1>
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>BYU Net ID</th>
                    <th>Name</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% users.forEach(user => { %>
                <tr>
                    <td><%= user.user_email %></td>
                    <td><%= user.user_first %></td>
                    <td><%= user.user_last %></td>
                    <td>
                        <a class="btn btn-sm btn-primary" href="/editUser/<%= encodeURIComponent(user.user_email) %>">Edit</a>
                        <form action="/deleteUser/<%= encodeURIComponent(user.user_email) %>" method="POST" class="d-inline"
                              onsubmit="return confirm('Delete <%= user.user_email %>?');">
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
        <a class="btn btn-secondary" href="/">Home</a>
        <a class="btn btn-success" href="/adduser">Add User</a>
    </div>

</body>
</html>